# ─── Product / campaign (fill with YOUR product — never commit real .env) ───
PRODUCT_NAME=Your Product
PRODUCT_DESCRIPTION=Describe what you sell and the customer problem you solve.
TARGET_MARKET=Describe ideal roles, company size, geos, and industries.
PRODUCT_WEBSITE=https://example.com
BOOKING_LINK=https://example.com/book
SENDER_NAME=Your Name
SENDER_TITLE=Founder & CEO
BOOKING_FROM_NAME=Your Product

# ─── LLM ────────────────────────────────────────────────────────────────────
# anthropic | openai (auto-detected from key prefix if empty)
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_CHEAP=gpt-4o-mini
LLM_MODEL_QUALITY=gpt-4o-mini
DAILY_BUDGET_USD=5.00

# ─── Lead discovery / enrichment (optional — use any subset or CSV) ─────────
BETTERCONTACT_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
APIFY_TOKEN=

# ─── Mailbox (SMTP send + IMAP replies) ─────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ─── Microsoft Graph / Outlook (preferred when set) ─────────────────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REFRESH_TOKEN=
MS_MAILBOX=

# ─── Telegram reporting (optional) ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_SENDS=true
TELEGRAM_NOTIFY_REPLIES=true
TELEGRAM_NOTIFY_BOOKINGS=true
TELEGRAM_NOTIFY_SUMMARY=true

# ─── Pipeline knobs ─────────────────────────────────────────────────────────
MAX_DISCOVER_PER_RUN=50
MAX_EMAIL_LOOKUPS_PER_DAY=25
MAX_SENDS_PER_DAY=20
QUALIFY_AUTO_ACCEPT=0.80
QUALIFY_AUTO_REJECT=0.30
PERSONALIZE_TOP_N_SOCIAL=5
FOLLOW_UP_HOURS=48
DRY_RUN=true

# ─── Runtime ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/gtm.db
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080
LOG_LEVEL=INFO
